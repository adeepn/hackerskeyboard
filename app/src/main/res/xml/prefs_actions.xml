<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    app:key="prefs_actions"
    app:title="@string/pref_screen_actions_title" >

    <PreferenceCategory
        app:key="swipe_actions"
        app:title="@string/title_swipe_gestures" >

        <ListPreference
            app:defaultValue="@string/default_swipe_up"
            app:entries="@array/swipe_action_entries"
            app:entryValues="@array/swipe_action_values"
            app:key="pref_swipe_up"
            app:persistent="true"
            app:title="@string/title_swipe_up"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="@string/default_swipe_down"
            app:entries="@array/swipe_action_entries"
            app:entryValues="@array/swipe_action_values"
            app:key="pref_swipe_down"
            app:persistent="true"
            app:title="@string/title_swipe_down"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="@string/default_swipe_left"
            app:entries="@array/swipe_action_entries"
            app:entryValues="@array/swipe_action_values"
            app:key="pref_swipe_left"
            app:persistent="true"
            app:title="@string/title_swipe_left"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="@string/default_swipe_right"
            app:entries="@array/swipe_action_entries"
            app:entryValues="@array/swipe_action_values"
            app:key="pref_swipe_right"
            app:persistent="true"
            app:title="@string/title_swipe_right"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="key_actions"
        app:title="@string/title_hardware_key_actions" >

        <ListPreference
            app:defaultValue="@string/default_vol_up"
            app:entries="@array/swipe_action_entries"
            app:entryValues="@array/swipe_action_values"
            app:key="pref_vol_up"
            app:persistent="true"
            app:title="@string/title_vol_up"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="@string/default_vol_down"
            app:entries="@array/swipe_action_entries"
            app:entryValues="@array/swipe_action_values"
            app:key="pref_vol_down"
            app:persistent="true"
            app:title="@string/title_vol_down"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
</PreferenceScreen>
